# ====================================================
# 环境变量配置示例
# 使用方法: 复制此文件为 .env 并填写实际值
# ====================================================

# 端口配置
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18081

# 当前阶段的临时登录账号。公开默认密码只能作为基础访问门槛。
# 环境变量留空时会使用 admin / StockAI@2026；后续可在 .env 中覆盖。
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=StockAI@2026

# 数据库保存在 Compose 的 stock-data 命名卷中。
# 模型 API Key、Endpoint 和 Model Name 通过应用的模型配置管理。
# Python 数据源配置读取 python-data-service/config.ini。
